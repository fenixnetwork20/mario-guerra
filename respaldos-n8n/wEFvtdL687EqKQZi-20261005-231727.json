POST","path":"MARIOGUERRA","options":{}},"type":"n8n-nodes-base.webhook","typeVersion":2,"position":[-1920,512],"id":"76b2b136-40c3-4fae-92d2-d717e0ad7915","name":"Webhook","webhookId":"5f89f767-2ac8-4da0-8be8-72189af56031"},{"parameters":{"promptType":"define","text":"=mensaje del cliente: {{ $('Redis1').item.json.message }}\nnombre del cliente: {{ $('Webhook').item.json.body.sender.name }}\nFECHA Y HORA ACTUAL:{{ $now.setZone('America/Caracas').setLocale('es').weekdayLong }} {{ $now.setZone('America/Caracas').toFormat('dd/LL/yyyy HH:mm:ss') }} \n\n\n","options":{"systemMessage":"={{ $json.nombre_negocio }}\n\n{{ $json.system_prompt }}\n\n{{ $json.horario }}\n"}},"type":"@n8n/n8n-nodes-langchain.agent","typeVersion":2,"position":[80,480],"id":"00e18ea4-5371-4068-ac89-42ec3dec2907","name":"AI Agent","retryOnFail":true,"maxTries":5,"waitBetweenTries":5000},{"parameters":{"sessionIdType":"customKey","sessionKey":"={{ $('Webhook').item.json.body.sender.id }}","tableName":"=MARIO_GUERRA_IG","contextWindowLength":10},"type":"@n8n/n8n-nodes-langchain.memoryPostgresChat","typeVersion":1.3,"position":[176,784],"id":"2a81c386-31aa-4741-8775-cc6fac22ead0","name":"Postgres Chat Memory","credentials":{"postgres":{"id":"c2Dmvv8nS8UMGzjE","name":"postgress Fenix "}}},{"parameters":{"jsCode":"const rawOutput = $input.first().json.output;\nlet mensaje = \"\";\nlet status = \"conversando\";\n\n// Gemini escribe saltos de línea REALES dentro del string del JSON. Eso es JSON\n// inválido y JSON.parse revienta — también en el segundo intento, que era el\n// agujero: cuando fallaba dos veces se le mandaba al paciente el `{\"mensaje\": ...`\n// completo, con las llaves a la vista. Medido: pasaba en 4 de cada 100 turnos.\nfunction extraer(txt) {\n  try { return JSON.parse(txt); } catch (e) { /* seguimos */ }\n  // Escapamos los saltos de línea que estén dentro de comillas y reintentamos.\n  const escapado = txt.replace(/\"(?:[^\"\\\\]|\\\\.)*\"/gs, (m) => m.replace(/\\r?\\n/g, \"\\\\n\"));\n  try { return JSON.parse(escapado); } catch (e) { /* seguimos */ }\n  const m = txt.match(/\\{[\\s\\S]*\"mensaje\"[\\s\\S]*\"status\"[\\s\\S]*\\}/);\n  if (m) {\n    try { return JSON.parse(m[0].replace(/\"(?:[^\"\\\\]|\\\\.)*\"/gs, (s) => s.replace(/\\r?\\n/g, \"\\\\n\"))); }\n    catch (e) { /* seguimos */ }\n  }\n  // Último recurso: sacar los dos campos a mano, tolerando saltos de línea.\n  const suelto = txt.match(/\"mensaje\"\\s*:\\s*\"([\\s\\S]*?)\"\\s*,\\s*\"status\"\\s*:\\s*\"([^\"]*)\"/);\n  if (suelto) return { mensaje: suelto[1], status: suelto[2] };\n\n  // Generación truncada: el modelo cortó antes de escribir \"status\" y todos los\n  // rescates de arriba lo exigen. Sin esto, al paciente le llega el `{\"mensaje\": …`\n  // a medias. Nos quedamos con el texto y seguimos conversando.\n  const soloMensaje = txt.match(/\"mensaje\"\\s*:\\s*\"([\\s\\S]*?)\"\\s*[,}]?\\s*$/);\n  if (soloMensaje) return { mensaje: soloMensaje[1], status: \"conversando\" };\n  return null;\n}\n\nconst parsed = extraer(rawOutput);\nif (parsed) {\n  mensaje = parsed.mensaje || \"\";\n  status = parsed.status || \"conversando\";\n} else {\n  mensaje = rawOutput;\n  status = \"conversando\";\n}\n\n// Red de seguridad: si aun así se coló la envoltura, se limpia antes de enviar.\nif (/^\\s*\\{\\s*\"mensaje\"/.test(mensaje)) {\n  const s2 = mensaje.match(/\"mensaje\"\\s*:\\s*\"([\\s\\S]*?)\"\\s*,\\s*\"status\"/);\n  if (s2) mensaje = s2[1];\n}\n\n// Forzar status \"agendado\" si el modelo no lo puso pero el mensaje confirma cita\nconst textoLower = mensaje.toLowerCase();\nif (status !== \"agendado\" && (\n  textoLower.includes(\"agendada\") ||\n  textoLower.includes(\"agendado\") ||\n  textoLower.includes(\"confirmada\") ||\n  textoLower.includes(\"confirmado\") ||\n  textoLower.includes(\"cita registrada\") ||\n  textoLower.includes(\"cita programada\") ||\n  textoLower.includes(\"ha sido creada\") ||\n  textoLower.includes(\"queda reservada\") ||\n  textoLower.includes(\"te esperamos\") ||\n  textoLower.includes(\"cita para el\")\n)) {\n  status = \"agendado\";\n}\n\n// Limpia asteriscos y normaliza los saltos de línea escapados\nmensaje = mensaje.replace(/\\*/g, '');\nmensaje = mensaje.replace(/\\\\n/g, '\\n').replace(/\\/n/g, '\\n').trim();\n\nreturn [{ json: { mensaje: mensaje, status: status } }];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[448,480],"id":"0e7e6670-226f-4670-b7ed-105ff62a04b5","name":"Code"},{"parameters":{"method":"POST","url":"=https://portal.odichat.app/api/v1/accounts/11/conversations/{{ $('Webhook').item.json.body.conversation.id }}/messages","sendHeaders":true,"headerParameters":{"parameters":[{"name":"api_access_token","value":"BcXP4hpQkNDU4SKiWSsQdGzU"},{"name":"Content-Type","value":"application/json"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={{ JSON.stringify({ content: $json.mensaje, message_type: 'outgoing' }) }}","options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[688,480],"id":"f3682e7a-d809-49f8-be14-d9121f2c6006","name":"HTTP Request"},{"parameters":{"rules":{"values":[{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"leftValue":"={{ $('Code').item.json.status }}","rightValue":"conversando","operator":{"type":"string","operation":"equals"},"id":"b7994de4-d2c5-4654-951a-8fff3c96b7cb"}],"combinator":"and"},"renameOutput":true,"outputKey":"conversando"},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"841da20f-267c-43da-a3d0-613f6a06f29c","leftValue":"={{ $('Code').item.json.status }}","rightValue":"agendado","operator":{"type":"string","operation":"equals"}}],"combinator":"and"},"renameOutput":true,"outputKey":"agendado"},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"330c139b-40fa-4ac7-baae-9398d7f2e69c","leftValue":"={{ $('Code').item.json