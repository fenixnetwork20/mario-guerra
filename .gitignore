node_modules
.next
next-env.d.ts
*.log

# Datos de pacientes y secretos: NO van en git.
# Su copia es el respaldo cifrado (scripts/respaldar.sh).
data/
.env.local

# Cualquier variante del entorno, no solo el archivo exacto: una copia .bak
# lleva el token de WhatsApp igual que el original.
.env.local*
*.tsbuildinfo

# Originales de la sesión de fotos del cliente (147 MB). Están en su Drive y en
# /root/mario guerra/. Al repositorio solo van las versiones optimizadas de
# public/marca/, que son las que usa el sitio.
branding/fotos-20260910/

# En respaldos/ solo entran los cifrados. Todo lo demás queda fuera para que un
# descuido no publique una base o un .env en claro.
respaldos/*
!respaldos/LEEME.md
!respaldos/diario/
!respaldos/semanal/
!respaldos/mensual/
respaldos/*/*
!respaldos/*/*.tar.gz.gpg
